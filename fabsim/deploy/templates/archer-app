#!/bin/bash
## archer-app
## number of nodes
#SBATCH --nodes $nodes

## task per node
#SBATCH --tasks-per-node=$corespernode

## wall time in format MINUTES:SECONDS
#SBATCH --time=$job_wall_time

## grant
#SBATCH --account=$budget

## stdout file
#SBATCH --output=$job_results/JobID-%j.output

## stderr file
#SBATCH --error=$job_results/JobID-%j.error

## Set the initial working directory to the work filesystem
## (otherwise sbatch warns when submitted from the ARCHER2 home filesystem)
#SBATCH --chdir=$job_results

## Request a specific partition ("queue") for the resource allocation
#SBATCH --partition=$partition_name
#SBATCH --qos=$qos_name


$run_prefix




